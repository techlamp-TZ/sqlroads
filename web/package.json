{
  "name": "sql-drills-web",
  "private": true,
  "type": "module",
  "description": "SQL Drills front end on the Waffles design system. Development only: the build output is committed into ../public/app/, so the running app needs none of this.",
  "scripts": {
    "tokens": "node tools/build-tokens.mjs",
    "build": "node tools/build-tokens.mjs && vite build && node tools/inject.mjs",
    "dev": "node tools/dev.mjs",
    "test": "vitest run",
    "audit:contrast": "node tools/contrast-audit.mjs"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@react-aria/focus": "3.22.1",
    "@storybook/react-vite": "10.6.2",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-toastify": "11.1.0",
    "react-uid": "2.4.0",
    "sass": "1.105.2",
    "sass-migrator": "2.6.1",
    "storybook": "10.6.2",
    "use-callback-ref": "1.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
