# AI hint providers. Copy this file to ".env" (same folder), paste the keys you have,
# then restart with `npm start`. Providers without a key show as "not set up".
# Keys stay on this computer: the browser never sees them.

# Claude (Anthropic API key)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (OpenAI API key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano

# DeepSeek (DeepSeek API key)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# "Auto" hints try these in order and fall back to the next on any failure.
# HINT_PROVIDER_ORDER=openai,claude,deepseek
